# Database
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth (required). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="xyz"

# Maileroo
MAILEROO_API_KEY="xyz"
EMAIL_FROM="xyz"
NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"

# Openrouter
OPENROUTER_API_KEY="xyz"

# Google OAuth
GOOGLE_CLIENT_ID="xyz"
GOOGLE_CLIENT_SECRET="xyz"

# AWS S3 / CloudFront (image management)
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="xyz"
AWS_SECRET_ACCESS_KEY="xyz"
S3_BUCKET_NAME="my-bucket"
CLOUDFRONT_DOMAIN="d1234567890.cloudfront.net"

# fal.ai (AI image generation)
FAL_KEY="xyz"
